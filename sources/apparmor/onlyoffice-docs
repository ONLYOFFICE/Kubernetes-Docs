abi <abi/3.0>,
#include <tunables/global>

# Single AppArmor profile for ONLYOFFICE Docs on Kubernetes.
#
# Load this file on every Linux worker node:
#   sudo install -m 0644 onlyoffice-docs /etc/apparmor.d/onlyoffice-docs
#   sudo apparmor_parser -r /etc/apparmor.d/onlyoffice-docs

profile onlyoffice-docs flags=(attach_disconnected,mediate_deleted) {
  #include <abstractions/base>
  #include <abstractions/nameservice>

  # Kernel and capability hardening.
  deny mount,
  deny remount,
  deny umount,
  deny pivot_root,
  deny ptrace,
  capability net_bind_service,
  deny capability sys_admin,       # blocks most container escape techniques
  deny capability sys_ptrace,      # disallow tracing other processes
  deny capability sys_module,      # disallow loading kernel modules
  deny capability sys_rawio,       # disallow direct hardware I/O
  deny capability net_admin,       # disallow network interface changes
  deny capability net_raw,         # disallow raw sockets through capabilities
  deny capability dac_override,    # disallow bypassing file permissions
  deny capability setuid,          # disallow UID switching through capabilities
  deny capability setgid,          # disallow GID switching through capabilities

  deny /boot/** rwklx,
  deny /sys/** wklx,
  deny /sys/kernel/debug/** r,
  deny /sys/kernel/tracing/** r,
  deny /sys/firmware/** r,
  deny /sys/bus/pci/devices/**/config rwx,
  deny /proc/kcore rwklx,

  deny /etc/passwd w,
  deny /etc/group w,
  deny /etc/gshadow wkl,
  deny /etc/shadow rwklx,
  deny /etc/sudoers wkl,
  deny /etc/sudoers.d/** wkl,
  deny /etc/ssh/** rwx,
  deny /root/.ssh/** rwx,
  deny /root/** rwklx,

  deny /etc/apt/** wkl,
  deny /etc/dnf/** wkl,
  deny /etc/yum.repos.d/** wkl,
  deny /var/cache/dnf/** wkl,
  deny /var/lib/dnf/** wkl,
  deny /var/lib/rpm/** wkl,

  deny /var/run/docker.sock rwx,
  deny /run/docker.sock rwx,
  deny /var/lib/docker/** rwx,
  deny /run/containerd/** rwx,
  deny /var/run/containerd/** rwx,

  deny /mnt/** wklx,
  deny /media/** wklx,
  deny /host/** rwx,

  deny /bin/** wkl,
  deny /sbin/** wkl,
  deny /lib/** wkl,
  deny /lib32/** wkl,
  deny /lib64/** wkl,
  deny /usr/bin/** wkl,
  deny /usr/sbin/** wkl,
  deny /usr/lib/** wkl,
  deny /usr/lib64/** wkl,
  deny /usr/libexec/** wkl,
  deny /usr/local/bin/** wkl,
  deny /usr/local/sbin/** wkl,

  # Network policy.
  network inet stream,
  network inet6 stream,
  network inet dgram,
  network inet6 dgram,
  network netlink raw,
  network unix stream,
  network unix dgram,
  deny network inet raw,
  deny network inet6 raw,
  deny network packet,

  # Shared runtime filesystem.
  / r,

  /usr/local/lib/** mr,
  /usr/lib/** mr,
  /usr/lib64/** mr,
  /lib/** mr,
  /lib64/** mr,

  /dev/null rw,
  /dev/zero rw,
  /dev/random r,
  /dev/urandom r,
  /dev/tty rw,
  /dev/stdout w,
  /dev/stderr w,
  /dev/pts/** rw,

  /proc/** r,
  /proc/self/** rw,
  /proc/[0-9]*/fd/** rw,
  /proc/[0-9]*/task/** r,
  deny /proc/self/attr/** rw,
  deny /proc/thread-self/attr/** rw,
  deny /proc/* w,
  deny /proc/sys/[^k]** w,
  deny /proc/sys/kernel/{?,??,[^s][^h][^m]**} w,
  deny /proc/sysrq-trigger rwx,
  deny /proc/kcore rwklx,
  deny /proc/kmem rwx,
  deny /proc/mem rwx,
  deny /proc/[0-9]*/mem rwx,
  deny /proc/[0-9]*/pagemap rwx,
  deny /proc/[0-9]*/clear_refs rwx,

  /run/** r,
  /run/secrets/** r,
  /run/secrets/kubernetes.io/serviceaccount/** r,
  deny /run/secrets/kubernetes.io/serviceaccount/token w,
  deny /var/run/secrets/kubernetes.io/serviceaccount/token w,
  /tmp/** rw,
  /tmp/.cache/pkg/** mrw,
  /var/tmp/** rw,

  # Entrypoints, shells, helper tools, and runtimes used by Docs containers.
  /bin/bash rix,
  /bin/busybox rix,
  /bin/sh rix,
  /usr/bin/bash rix,
  /usr/bin/basename rix,
  /usr/bin/busybox rix,
  /usr/bin/chmod rix,
  /usr/bin/chown rix,
  /usr/bin/cp rix,
  /usr/bin/curl rix,
  /usr/bin/dirname rix,
  /usr/bin/env rix,
  /usr/bin/envsubst rix,
  /usr/bin/find rix,
  /usr/bin/gzip rix,
  /usr/bin/htpasswd rix,
  /usr/bin/ls rix,
  /usr/bin/mkdir rix,
  /usr/bin/nginx rix,
  /usr/bin/psql rix,
  /usr/bin/python3 rix,
  /usr/bin/rm rix,
  /usr/bin/sed rix,
  /usr/bin/sh rix,
  /usr/bin/sleep rix,
  /usr/bin/tee rix,
  /usr/bin/wget rix,
  /usr/local/bin/docker-entrypoint.sh rix,
  /usr/local/bin/dumb-init rix,
  /usr/local/bin/node rix,
  /usr/local/bin/npm rix,
  /usr/local/bin/proxy-docker-entrypoint.sh rix,
  /usr/local/bin/python rix,
  /usr/local/bin/python3 rix,
  /usr/local/lib/node_modules/npm/bin/npm-cli.js rix,
  /usr/sbin/nginx rix,
  /init/** rix,

  # System data loaded by runtime helpers.
  /etc/gss/mech.d/ r,
  /etc/gss/mech.d/** r,
  /etc/nginx/ r,
  /etc/nginx/** r,
  /etc/onlyoffice/** r,
  /etc/pki/tls/openssl.cnf r,
  /etc/pki/tls/openssl.d/ r,
  /etc/pki/tls/openssl.d/** r,
  /etc/wgetrc r,
  /usr/lib/postgresql/** rix,
  /usr/local/lib/node_modules/** r,
  /usr/local/lib/python3.11/__pycache__/ rw,
  /usr/local/lib/python3.11/__pycache__/** rw,
  /usr/local/lib/python3.11/**/__pycache__/ rw,
  /usr/local/lib/python3.11/**/__pycache__/** rw,
  /usr/share/nginx/modules/ r,
  /usr/share/nginx/modules/** r,
  /usr/share/perl5/** r,
  /usr/share/postgresql-common/** rix,
  /sys/fs/cgroup/memory.* r,

  # ONLYOFFICE Docs config, app tree, runtime state, and generated cache.
  /etc/onlyoffice/documentserver/log4js/ rw,
  /etc/onlyoffice/documentserver/log4js/** rw,
  /var/www/onlyoffice/** r,
  /var/www/onlyoffice/config/** rw,
  /var/www/onlyoffice/documentserver/** r,
  /var/www/onlyoffice/documentserver/server/AdminPanel/server/adminpanel rix,
  /var/www/onlyoffice/documentserver/server/DocService/docservice rix,
  /var/www/onlyoffice/documentserver/server/FileConverter/converter rix,
  /var/www/onlyoffice/documentserver/server/FileConverter/bin/** rix,
  /var/www/onlyoffice/documentserver/server/tools/** rix,
  /client/ r,
  /client/build/** r,
  /var/www/onlyoffice/documentserver/web-apps/apps/api/documents/api.js rw,
  /var/www/onlyoffice/documentserver/web-apps/apps/api/documents/api.js.gz rw,
  /var/www/onlyoffice/documentserver/fonts/** r,
  /var/www/onlyoffice/documentserver/core-fonts/custom-k8s/** r,
  /var/www/onlyoffice/documentserver/sdkjs/common/** r,
  /var/www/onlyoffice/documentserver/sdkjs/slide/themes/** r,
  /var/www/onlyoffice/documentserver/sdkjs/cell/** r,
  /var/www/onlyoffice/documentserver/sdkjs/word/** r,
  /var/www/onlyoffice/documentserver/sdkjs/slide/** r,
  /var/www/onlyoffice/documentserver/sdkjs/visio/** r,
  /var/www/onlyoffice/documentserver/sdkjs-plugins/** r,
  /var/www/onlyoffice/documentserver/dictionaries/** r,
  /var/lib/onlyoffice/** r,
  /var/lib/onlyoffice/documentserver/** rw,

  # Example app data.
  /etc/onlyoffice/documentserver-example/ r,
  /etc/onlyoffice/documentserver-example/** r,
  /var/www/onlyoffice/documentserver-example/ r,
  /var/www/onlyoffice/documentserver-example/** r,
  /var/www/onlyoffice/documentserver-example/.npm/ rw,
  /var/www/onlyoffice/documentserver-example/.npm/** rw,
  /var/www/onlyoffice/documentserver-example/welcome/ rw,
  /var/www/onlyoffice/documentserver-example/welcome/** rw,
  /var/lib/onlyoffice/documentserver-example/** rw,

  # Proxy-generated nginx config and logs.
  /tmp/proxy_nginx/** rw,
  /tmp/http-upstream.conf rw,
  /tmp/auth rw,
  /var/log/nginx/** rw,

  # Helm hooks, tests, WOPI jobs, and maintenance scripts.
  /scripts/ rw,
  /scripts/*.sql rw,
  /scripts/*.json rw,
  /scripts/wopi_*.key rw,
  /scripts/clearCache.sh rix,
  /scripts/get_dashboard.sh rix,
  /scripts/initdb.sh rix,
  /scripts/stop.sh rix,
  /scripts/test_ds.py rix,
  /scripts/wopi_keys_del.py rix,
  /scripts/wopi_keys_gen.py rix,
  /ds/** rw,
}
